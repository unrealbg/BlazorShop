@page "/authentication/login"
@page "/authentication/login/{*route}"
@layout AccessLayout

<PageTitle>Sign in | BlazorShop</PageTitle>
<section class="v2-auth-card" aria-labelledby="login-title">
    <p class="v2-eyebrow">Account</p>
    <h1 id="login-title">Sign in</h1>
    <p class="v2-muted">Access your orders, profile and notifications.</p>
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="v2-notice @(_alertType == "danger" ? "v2-notice-error" : "v2-notice-success")" role="alert">@_message</div>
    }
    <EditForm Model="User" OnValidSubmit="LoginUser" class="v2-form" aria-busy="@IsSubmitting">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />
        <div>
            <FloatingTextInput @bind-Value="User.Email" Label="Email Address" Type="email" autocomplete="username" Placeholder="you@example.com" aria-describedby="login-email-error" />
            <div id="login-email-error"><ValidationMessage For="@(() => User.Email)" /></div>
        </div>
        <div>
            <FloatingTextInput @bind-Value="User.Password" Label="Password" Type="password" autocomplete="current-password" aria-describedby="login-password-error" />
            <div id="login-password-error"><ValidationMessage For="@(() => User.Password)" /></div>
        </div>
        <button type="submit" class="bs-button bs-button-primary v2-full" disabled="@IsSubmitting">@(IsSubmitting ? "Signing in..." : "Login")</button>
    </EditForm>
    <div class="v2-divider"><span>New to BlazorShop?</span></div>
    <a href="/authentication/register" class="bs-button bs-button-secondary v2-full">Create account</a>
    <details class="v2-demo">
        <summary>Explore a demo workspace</summary>
        <p class="v2-muted">Try a customer or administrator account in an isolated, temporary workspace. Changes reset on logout or expiry.</p>
        <div class="v2-demo-actions">
            <button type="button" class="bs-button bs-button-secondary" disabled="@IsSubmitting" @onclick='() => StartDemo("User")'>Customer demo</button>
            <button type="button" class="bs-button bs-button-secondary" disabled="@IsSubmitting" @onclick='() => StartDemo("Admin")'>Administrator demo</button>
        </div>
    </details>
</section>
