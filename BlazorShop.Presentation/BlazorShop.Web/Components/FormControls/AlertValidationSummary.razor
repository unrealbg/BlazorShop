@implements IDisposable

@*
    Announces form validation errors without breaking list semantics.
    Putting role="alert" directly on ValidationSummary replaces the role of its <ul>,
    which leaves the <li> items without a list parent (axe "listitem", RC audit R05).
    The alert wrapper is rendered only while messages exist, matching ValidationSummary,
    so forms without errors expose no empty alert region.
*@
@if (_hasMessages)
{
    <div @attributes="AdditionalAttributes" role="alert">
        <ValidationSummary />
    </div>
}

@code {
    private EditContext? _subscribedContext;
    private bool _hasMessages;

    [CascadingParameter]
    private EditContext? CurrentEditContext { get; set; }

    /// <summary>
    /// Attributes such as <c>class</c> are applied to the alert wrapper, which is the element
    /// that takes the summary's place in the surrounding layout.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    public void Dispose() => Unsubscribe();

    protected override void OnParametersSet()
    {
        if (CurrentEditContext is null)
        {
            throw new InvalidOperationException(
                $"{nameof(AlertValidationSummary)} requires a cascading parameter of type {nameof(EditContext)}. Use it inside an EditForm.");
        }

        if (!ReferenceEquals(CurrentEditContext, _subscribedContext))
        {
            Unsubscribe();
            _subscribedContext = CurrentEditContext;
            _subscribedContext.OnValidationStateChanged += HandleValidationStateChanged;
        }

        _hasMessages = CurrentEditContext.GetValidationMessages().Any();
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        var hasMessages = _subscribedContext?.GetValidationMessages().Any() == true;
        if (hasMessages != _hasMessages)
        {
            _hasMessages = hasMessages;
            StateHasChanged();
        }
    }

    private void Unsubscribe()
    {
        if (_subscribedContext is not null)
        {
            _subscribedContext.OnValidationStateChanged -= HandleValidationStateChanged;
            _subscribedContext = null;
        }
    }
}
