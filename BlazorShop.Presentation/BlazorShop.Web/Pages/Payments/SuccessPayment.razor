@page "/payment-success"
@page "/payment-success/{bt:int?}"

<section class="success-payment">
    <div class="card shadow-sm success-payment-card">
        <div class="card-header text-center">
            <h4 class="mb-0">Order received</h4>
        </div>
        <div class="card-body">
            <div class="alert alert-success text-center" role="status">
                <h4 class="alert-heading">Thank you for your order!</h4>
                @if (NormalizedPaymentMethod == "card")
                {
                    <p>Your order already exists. Its payment status will be updated from Stripe's trusted server notification.</p>
                }
                else if (NormalizedPaymentMethod == "bank" || Bt.GetValueOrDefault() == 1)
                {
                    <p>Your order is awaiting the bank transfer described in your checkout instructions.</p>
                }
                else
                {
                    <p>Your order was placed successfully and is awaiting fulfillment.</p>
                }

                @if (OrderId.HasValue || !string.IsNullOrWhiteSpace(OrderReference))
                {
                    <hr>
                    <dl class="mb-0">
                        @if (!string.IsNullOrWhiteSpace(OrderReference))
                        {
                            <dt>Order reference</dt>
                            <dd>@OrderReference</dd>
                        }
                        @if (OrderId.HasValue)
                        {
                            <dt>Order ID</dt>
                            <dd>@OrderId.Value</dd>
                        }
                    </dl>
                }

                <hr>
                <p class="mb-0">View the current server-known status on the <a href="/account/orders">Orders</a> page.</p>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "bt")]
    public int? Bt { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "pm")]
    public string? PaymentMethod { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "order_id")]
    public Guid? OrderId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "reference")]
    public string? OrderReference { get; set; }

    private string? NormalizedPaymentMethod => PaymentMethod?.Trim().ToLowerInvariant();
}
