@inject IPublicStorefrontUrlResolver StorefrontUrlResolver
@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="v2-admin" @ref="_shell">
    <Toast />
    <a class="v2-admin-skip" href="@(NavigationManager.Uri.Split('#')[0] + "#admin-content")" @onclick="FocusContentAsync" @onclick:preventDefault>Skip to content</a>
    <aside class="v2-admin-sidebar">
        <a href="/admin" class="v2-admin-brand">Blazor<span>Shop</span><small>ADMIN WORKSPACE</small></a>
        <nav aria-label="Admin navigation"><AdminNavigation /></nav>
    </aside>
    <div class="v2-admin-workspace">
        <WorkspaceHeader BrandHref="/admin" ModeLabel="ADMIN OPERATIONS">
            <PrimaryNavigation><AdminNavigation /></PrimaryNavigation>
            <Actions>
                <a href="@ShopHref" class="v2-admin-header-link">Back to shop</a>
                <a href="/account" class="v2-admin-header-link">Account</a>
                <a href="/authentication/logout" class="v2-admin-header-link">Sign out</a>
            </Actions>
            <MobileActions><a href="@ShopHref" class="v2-admin-header-link">Shop</a></MobileActions>
            <MobilePanelActions>
                <a href="@ShopHref">Back to shop</a>
                <a href="/account">Account</a>
                <a href="/authentication/logout">Sign out</a>
            </MobilePanelActions>
        </WorkspaceHeader>
        <main id="admin-content" tabindex="-1" @ref="_content">@Body</main>
    </div>
</div>

@code {
    private ElementReference _shell;
    private ElementReference _content;
    private IJSObjectReference? _module;
    private bool _disposed;
    private string ShopHref => StorefrontNavigationHref.ResolveShopHref(StorefrontUrlResolver);

    private async Task FocusContentAsync() => await _content.FocusAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/adminUi.js");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }
            _module = module;
            await _module.InvokeVoidAsync("initializeShell", _shell);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("disposeShell", _shell);
            await _module.DisposeAsync();
        }
    }
}
