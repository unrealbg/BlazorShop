@page "/my-cart"
@inject StorefrontApiClient ApiClient
@inject IStorefrontClientAppUrlResolver ClientAppUrlResolver

<PageTitle>My Cart</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex,nofollow" />
</HeadContent>

<div class="bs-v2-container bs-v2-cart">
    <header class="bs-v2-cart-intro">
        <div>
            <p class="bs-v2-eyebrow">Your bag</p>
            <h1>My Cart</h1>
            <p>Review your items before continuing to checkout.</p>
        </div>
        <span class="bs-v2-count" role="status">@ItemCount item@(ItemCount == 1 ? string.Empty : "s") in cart</span>
    </header>

    @foreach (var alert in Alerts)
    {
        <div class="bs-v2-cart-alert @(alert.Level == "error" ? "bs-v2-cart-error" : "bs-v2-cart-warning")" role="alert">
            @alert.Message
        </div>
    }

    <div class="bs-v2-cart-layout">
        <section class="bs-v2-cart-panel" aria-label="Cart items">
            @if (Lines.Count == 0)
            {
                <div class="bs-v2-cart-empty" role="status">
                    <h2>Your cart is empty</h2>
                    <p>Add products from the storefront to review them here before checkout.</p>
                    <div class="bs-v2-cart-empty-actions">
                        <a href="@StorefrontRoutes.NewReleases" class="bs-v2-button bs-v2-button-primary">Shop New Releases</a>
                        <a href="@StorefrontRoutes.TodaysDeals" class="bs-v2-button bs-v2-button-secondary">See Today's Deals</a>
                    </div>
                </div>
            }
            else
            {
                @for (var index = 0; index < Lines.Count; index++)
                {
                    var line = Lines[index];
                    var titleId = $"cart-title-{index}";
                    var variantId = $"cart-variant-{index}";
                    var quantityId = $"cart-quantity-{index}";
                    var removeDescription = string.IsNullOrWhiteSpace(line.VariantLabel) ? titleId : $"{titleId} {variantId}";
                    <article class="bs-v2-cart-line" aria-labelledby="@titleId">
                        <div class="bs-v2-cart-image">
                            @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                            {
                                <img src="@line.ImageUrl" alt="@line.DisplayName" width="88" height="88" />
                            }
                            else
                            {
                                <span class="bs-v2-image-placeholder">No image available</span>
                            }
                        </div>
                        <div class="bs-v2-cart-product">
                            <h2 id="@titleId">
                                @if (!string.IsNullOrWhiteSpace(line.ProductUrl))
                                {
                                    <a href="@line.ProductUrl">@line.DisplayName</a>
                                }
                                else
                                {
                                    @line.DisplayName
                                }
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(line.VariantLabel))
                            {
                                <p id="@variantId" class="bs-v2-cart-variant">@line.VariantLabel</p>
                            }
                            @if (line.IsUnavailable)
                            {
                                <p class="bs-v2-cart-unavailable">This item is unavailable or could not be refreshed. Review it before checkout.</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.ProductUrl))
                            {
                                <a href="@line.ProductUrl" class="bs-v2-cart-product-link">View Product</a>
                            }
                        </div>
                        <div class="bs-v2-cart-line-controls">
                            <dl class="bs-v2-cart-prices">
                                <div><dt>Unit Price</dt><dd>EUR @line.UnitPriceDisplay</dd></div>
                                <div><dt>Line Total</dt><dd>EUR @line.LineTotalDisplay</dd></div>
                            </dl>
                            <div class="bs-v2-cart-line-actions">
                                <div class="bs-v2-cart-quantity">
                                    <label for="@quantityId">Quantity</label>
                                    <input id="@quantityId"
                                           type="number"
                                           min="1"
                                           step="1"
                                           value="@line.Quantity"
                                           aria-label="Quantity for @line.DisplayName @line.VariantLabel"
                                           data-storefront-cart-quantity
                                           data-product-id="@line.ProductId"
                                           data-variant-id="@line.VariantId"
                                           data-product-name="@line.DisplayName"
                                           data-size-value="@line.SizeValue" />
                                </div>
                                <button type="button"
                                        class="bs-v2-button bs-v2-button-secondary bs-v2-cart-remove"
                                        aria-describedby="@removeDescription"
                                        data-storefront-cart-remove
                                        data-product-id="@line.ProductId"
                                        data-variant-id="@line.VariantId"
                                        data-product-name="@line.DisplayName"
                                        data-size-value="@line.SizeValue">Remove</button>
                            </div>
                        </div>
                    </article>
                }

                <p class="bs-v2-cart-notice">Prices shown are informational. The server revalidates products, variants, prices and stock at checkout.</p>
            }
        </section>

        <aside class="bs-v2-cart-summary" aria-labelledby="cart-summary-heading">
            <h2 id="cart-summary-heading">Order Summary</h2>
            <dl class="bs-v2-cart-totals">
                <div><dt>Items</dt><dd>@ItemCount</dd></div>
                <div><dt>Subtotal</dt><dd>EUR @GrandTotalDisplay</dd></div>
                <div class="bs-v2-cart-total"><dt>Total</dt><dd>EUR @GrandTotalDisplay</dd></div>
            </dl>
            <div class="bs-v2-cart-summary-actions">
                @if (Lines.Count > 0)
                {
                    <a href="@CheckoutUrl" class="bs-v2-button bs-v2-button-primary">Continue to Checkout</a>
                    <p>Checkout continues with your account.</p>
                    <button type="button" data-storefront-cart-clear class="bs-v2-button bs-v2-button-secondary">Clear Cart</button>
                }
                <a href="@StorefrontRoutes.NewReleases" class="bs-v2-button bs-v2-button-secondary">Continue Shopping</a>
            </div>
        </aside>
    </div>
</div>
