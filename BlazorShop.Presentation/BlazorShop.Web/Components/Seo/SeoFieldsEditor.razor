@using BlazorShop.Web.Shared.Models.Seo

<div class="space-y-5">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div>
            <label class="block text-xs text-neutral-600 mb-1" for="admin-seofieldseditor-51">Slug</label>
            <InputText id="admin-seofieldseditor-51" @bind-Value="Model.Slug" class="w-full border rounded px-3 py-2" aria-describedby="admin-seofieldseditor-51-error" />
            <div id="admin-seofieldseditor-51-error" role="status"><ValidationMessage For="@(() => Model.Slug)" /></div>
            <div class="mt-1 text-xs text-neutral-500">Required when the entry is published.</div>
        </div>
        <div>
            <label class="block text-xs text-neutral-600 mb-1" for="admin-seofieldseditor-52">Canonical URL</label>
            <InputText id="admin-seofieldseditor-52" @bind-Value="Model.CanonicalUrl" class="w-full border rounded px-3 py-2" aria-describedby="admin-seofieldseditor-52-error" />
            <div id="admin-seofieldseditor-52-error" role="status"><ValidationMessage For="@(() => Model.CanonicalUrl)" /></div>
        </div>
        <div>
            <label class="block text-xs text-neutral-600 mb-1" for="admin-seofieldseditor-53">Meta Title</label>
            <InputText id="admin-seofieldseditor-53" @bind-Value="Model.MetaTitle" class="w-full border rounded px-3 py-2" aria-describedby="admin-seofieldseditor-53-error" />
            <div id="admin-seofieldseditor-53-error" role="status"><ValidationMessage For="@(() => Model.MetaTitle)" /></div>
        </div>
        <div>
            <label class="block text-xs text-neutral-600 mb-1" for="admin-seofieldseditor-54">Open Graph Title</label>
            <InputText id="admin-seofieldseditor-54" @bind-Value="Model.OgTitle" class="w-full border rounded px-3 py-2" aria-describedby="admin-seofieldseditor-54-error" />
            <div id="admin-seofieldseditor-54-error" role="status"><ValidationMessage For="@(() => Model.OgTitle)" /></div>
        </div>
        <div>
            <label class="block text-xs text-neutral-600 mb-1" for="admin-seofieldseditor-55">Meta Description</label>
            <InputTextArea id="admin-seofieldseditor-55" @bind-Value="Model.MetaDescription" class="w-full border rounded px-3 py-2 min-h-28" aria-describedby="admin-seofieldseditor-55-error" />
            <div id="admin-seofieldseditor-55-error" role="status"><ValidationMessage For="@(() => Model.MetaDescription)" /></div>
        </div>
        <div>
            <label class="block text-xs text-neutral-600 mb-1" for="admin-seofieldseditor-56">Open Graph Description</label>
            <InputTextArea id="admin-seofieldseditor-56" @bind-Value="Model.OgDescription" class="w-full border rounded px-3 py-2 min-h-28" aria-describedby="admin-seofieldseditor-56-error" />
            <div id="admin-seofieldseditor-56-error" role="status"><ValidationMessage For="@(() => Model.OgDescription)" /></div>
        </div>
        <div class="lg:col-span-2">
            <label class="block text-xs text-neutral-600 mb-1" for="admin-seofieldseditor-57">Open Graph Image</label>
            <InputText id="admin-seofieldseditor-57" @bind-Value="Model.OgImage" class="w-full border rounded px-3 py-2" aria-describedby="admin-seofieldseditor-57-error" />
            <div id="admin-seofieldseditor-57-error" role="status"><ValidationMessage For="@(() => Model.OgImage)" /></div>
        </div>
    </div>

    <div class="rounded border bg-neutral-50 px-4 py-3">
        <div class="text-sm font-semibold text-neutral-800">Indexing Controls</div>
        <div class="mt-3 flex flex-wrap gap-6">
            <label class="inline-flex items-center gap-2 text-sm text-neutral-700">
                <InputCheckbox @bind-Value="Model.IsPublished" class="h-4 w-4" />
                <span>Published</span>
            </label>
            <label class="inline-flex items-center gap-2 text-sm text-neutral-700">
                <InputCheckbox @bind-Value="Model.RobotsIndex" class="h-4 w-4" />
                <span>Allow indexing</span>
            </label>
            <label class="inline-flex items-center gap-2 text-sm text-neutral-700">
                <InputCheckbox @bind-Value="Model.RobotsFollow" class="h-4 w-4" />
                <span>Allow follow</span>
            </label>
        </div>
        @if (Model.IsPublished && string.IsNullOrWhiteSpace(Model.Slug))
        {
            <div class="mt-3 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
                Published entries need a slug before the backend will accept the update.
            </div>
        }
    </div>

    <div>
        <label class="block text-xs text-neutral-600 mb-1" for="admin-seofieldseditor-58">SEO Content</label>
        <InputTextArea id="admin-seofieldseditor-58" @bind-Value="Model.SeoContent" class="w-full border rounded px-3 py-2 min-h-40" aria-describedby="admin-seofieldseditor-58-error" />
        <div id="admin-seofieldseditor-58-error" role="status"><ValidationMessage For="@(() => Model.SeoContent)" /></div>
    </div>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public SeoFieldsBase Model { get; set; } = default!;
}