@page "/confirm-email"
@layout AccessLayout

<PageTitle>Email confirmation | BlazorShop</PageTitle>
<section class="v2-auth-card v2-confirmation" aria-labelledby="confirmation-title" aria-busy="@_isLoading">
    <p class="v2-eyebrow">Account verification</p>
    <div class="v2-confirmation-icon" aria-hidden="true">@(_isLoading ? "…" : _isSuccess ? "✓" : "!")</div>
    <h1 id="confirmation-title">Email confirmation</h1>
    @if (_isLoading)
    {
        <p class="v2-muted" role="status">Processing your request...</p>
    }
    else if (!string.IsNullOrEmpty(_message))
    {
        <div class="v2-notice @(_isSuccess ? "v2-notice-success" : "v2-notice-error")" role="status">@_message</div>
        <a href="/authentication/login/account" class="bs-button bs-button-primary v2-full">Go to Login</a>
        @if (!_isSuccess)
        {
            <p class="v2-muted v2-small">Use the complete confirmation link from your email. If you still need help, return to sign in.</p>
        }
    }
</section>
