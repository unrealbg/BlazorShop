@page "/authentication/login"
@page "/authentication/login/{*route}"

<section class="w-full px-4 py-5 sm:px-6 sm:py-8 lg:px-8 lg:pt-5 lg:pb-7">
  <div class="mx-auto grid w-full max-w-[66rem] items-start gap-7 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-8 xl:w-fit xl:max-w-full xl:grid-cols-[42rem_20rem] xl:justify-center">
    <div class="bs-panel overflow-hidden">
      <div class="border-b border-slate-200 px-5 py-6 sm:px-8 sm:py-7">
        <div class="mx-auto max-w-lg">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Account</p>
              <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Sign in</h1>
              <p class="mt-3 text-sm leading-6 text-slate-600">Open orders, notifications, settings, and checkout continuation.</p>
            </div>

            <a href="/authentication/register" class="bs-button bs-button-secondary w-full shrink-0 justify-center whitespace-nowrap sm:w-auto">Create account</a>
          </div>
        </div>
      </div>

      <div class="px-5 py-6 sm:px-8 sm:py-7">
        @if (!string.IsNullOrEmpty(_message))
        {
          <div class="mx-auto mb-4 max-w-lg rounded-2xl px-4 py-3 text-sm font-medium @( _alertType == "danger" ? "bg-red-50 text-red-700" : "bg-emerald-50 text-emerald-700")" role="alert">
            @_message
          </div>
        }

        <div class="mx-auto max-w-lg">
          <div class="mb-7 rounded-2xl border border-sky-200 bg-sky-50 p-4 sm:p-5">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-sky-700">Isolated demo workspace</p>
            <h2 class="mt-2 text-xl font-black text-slate-950">Try the complete application</h2>
            <p class="mt-2 text-sm leading-6 text-slate-700">Each button creates a private 30-minute sandbox. Products, orders, users, settings, and uploads reset on logout or expiry.</p>

            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <button type="button" class="bs-button bs-button-secondary w-full justify-center disabled:opacity-60" disabled="@IsSubmitting" @onclick='() => StartDemo("User")'>Customer demo</button>
              <button type="button" class="bs-button bs-button-primary w-full justify-center disabled:opacity-60" disabled="@IsSubmitting" @onclick='() => StartDemo("Admin")'>Administrator demo</button>
            </div>

            <div class="mt-4 grid gap-2 text-xs text-slate-600 sm:grid-cols-2">
              <div><span class="font-semibold">Customer:</span> demo.user@blazorshop.local</div>
              <div><span class="font-semibold">Admin:</span> demo.admin@blazorshop.local</div>
              <div class="sm:col-span-2"><span class="font-semibold">Password:</span> Demo123!</div>
            </div>
          </div>

          <EditForm Model="User" OnValidSubmit="LoginUser">
            <DataAnnotationsValidator />
            <ValidationSummary class="mb-5 text-sm text-red-700" />
            <div class="mb-5">
              <ValidationMessage For="@(() => User.Email)" />
              <FloatingTextInput class="w-full border rounded px-3 py-2" @bind-Value="User.Email" Label="Email Address" Type="text" Placeholder="my@email.com" />
            </div>

            <div class="mb-7">
              <ValidationMessage For="@(() => User.Password)" />
              <FloatingTextInput class="w-full border rounded px-3 py-2" @bind-Value="User.Password" Label="Password" Type="Password" Placeholder="Password" />
            </div>

            <button type="submit" class="bs-button bs-button-primary w-full disabled:opacity-60 disabled:cursor-not-allowed" disabled="@IsSubmitting">@(IsSubmitting ? "Signing in..." : "Login")</button>
          </EditForm>
        </div>
      </div>

      <div class="border-t border-slate-200 px-5 py-5 sm:px-8">
        <div class="mx-auto flex max-w-lg flex-wrap items-center justify-between gap-3 text-sm text-slate-600">
          <span>Don't have an account yet?</span>
          <div class="bs-shell-inline-links">
            <a href="/authentication/register">Register</a>
            <a href="/">Access home</a>
          </div>
        </div>
      </div>
    </div>

    <aside class="space-y-5">
      <div class="bs-panel-soft p-6">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">After sign-in</p>
        <div class="mt-5 space-y-4">
          <div class="rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm">
            <div class="font-semibold text-slate-950">Account dashboard</div>
            <div class="mt-1 text-slate-600">Profile summary, unread notifications, and shortcuts.</div>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm">
            <div class="font-semibold text-slate-950">Orders and checkout</div>
            <div class="mt-1 text-slate-600">History, shipment state, and authenticated checkout continuation.</div>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm">
            <div class="font-semibold text-slate-950">Admin tools</div>
            <div class="mt-1 text-slate-600">Available automatically when your role includes admin access.</div>
          </div>
        </div>
      </div>

      <div class="bs-panel-soft p-6">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Quick links</p>
        <div class="mt-5 flex flex-col gap-3 text-sm font-semibold">
          <a href="/authentication/register" class="bs-button bs-button-primary">Create account</a>
          <a href="/" class="bs-button bs-button-ghost">Access home</a>
        </div>
      </div>
    </aside>
  </div>
</section>

