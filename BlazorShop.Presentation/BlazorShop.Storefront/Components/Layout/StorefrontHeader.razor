<header class="bs-v2-storefront-header">
    <a class="bs-v2-skip-link" href="#main-content">Skip to content</a>
    <div class="bs-v2-header-main bs-v2-container">
        <a href="@StorefrontRoutes.Home" class="bs-v2-brand" aria-label="BlazorShop public shop home">Blazor<span>Shop</span></a>

        <div class="bs-v2-header-message">Discover great products, all in one place.</div>

        <div class="bs-v2-header-actions" aria-label="Shop actions">
            <a href="@StorefrontRoutes.Cart" class="bs-v2-cart-action" aria-label="Open cart" title="Open cart">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M3 4h2.2l1.8 10h10.7l2-7H6.1" />
                    <circle cx="9" cy="19" r="1.4" />
                    <circle cx="17" cy="19" r="1.4" />
                </svg>
                <span class="bs-v2-cart-label">Cart</span>
                <span data-storefront-cart-badge hidden class="bs-storefront-cart-badge">0</span>
            </a>
            <StorefrontAccountMenu />
        </div>
    </div>

    <div class="bs-v2-navline">
        <nav class="bs-v2-container bs-v2-desktop-nav" aria-label="Primary shop navigation">
            <NavLink href="@StorefrontRoutes.Home" Match="NavLinkMatch.All" ActiveClass="is-active">Home</NavLink>
            <NavLink href="@StorefrontRoutes.NewReleases" ActiveClass="is-active">New Releases</NavLink>
            <NavLink href="@StorefrontRoutes.TodaysDeals" ActiveClass="is-active">Today's Deals</NavLink>
            <NavLink href="@StorefrontRoutes.About" ActiveClass="is-active">About</NavLink>
            <NavLink href="@StorefrontRoutes.CustomerService" ActiveClass="is-active">Customer Service</NavLink>
        </nav>
    </div>

    <details class="bs-v2-mobile-nav">
        <summary>Browse shop <span aria-hidden="true">☰</span></summary>
        <nav aria-label="Mobile shop navigation">
            <NavLink href="@StorefrontRoutes.Home" Match="NavLinkMatch.All" ActiveClass="is-active">Home</NavLink>
            <NavLink href="@StorefrontRoutes.NewReleases" ActiveClass="is-active">New Releases</NavLink>
            <NavLink href="@StorefrontRoutes.TodaysDeals" ActiveClass="is-active">Today's Deals</NavLink>
            <NavLink href="@StorefrontRoutes.About" ActiveClass="is-active">About</NavLink>
            <NavLink href="@StorefrontRoutes.CustomerService" ActiveClass="is-active">Customer Service</NavLink>
        </nav>
    </details>
</header>
