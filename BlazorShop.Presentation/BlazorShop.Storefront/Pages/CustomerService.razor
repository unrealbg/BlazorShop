@page "/customer-service"
@inject IStorefrontSeoSettingsProvider SettingsProvider
@inject IStorefrontSeoComposer SeoComposer
@inject IStorefrontStructuredDataComposer StructuredDataComposer

<SeoHead Metadata="_metadata" StructuredData="_structuredData" />

<section class="bs-v2-info">
    <header class="bs-v2-info-heading"><p class="bs-v2-info-eyebrow">Support</p><h1>Customer Service</h1><p>Find order information and answers to common storefront questions.</p></header>
    <div class="bs-v2-info-grid">
        <section class="bs-v2-info-panel"><p class="bs-v2-info-eyebrow">Get in touch</p><h2>Contact</h2>
            @if (!string.IsNullOrWhiteSpace(_contacts?.CompanyName)) { <p><strong>@_contacts.CompanyName</strong></p> }
            <dl class="bs-v2-info-contacts">
                @if (!string.IsNullOrWhiteSpace(_contacts?.CompanyEmail)) { <div><dt>Email</dt><dd>@_contacts.CompanyEmail</dd></div> }
                @if (!string.IsNullOrWhiteSpace(_contacts?.CompanyPhone)) { <div><dt>Phone</dt><dd>@_contacts.CompanyPhone</dd></div> }
                @if (!string.IsNullOrWhiteSpace(_contacts?.CompanyAddress)) { <div><dt>Address</dt><dd>@_contacts.CompanyAddress</dd></div> }
            </dl>
            @if (string.IsNullOrWhiteSpace(_contacts?.CompanyEmail) && string.IsNullOrWhiteSpace(_contacts?.CompanyPhone) && string.IsNullOrWhiteSpace(_contacts?.CompanyAddress))
            { <p class="bs-v2-info-notice">Contact details have not been provided for this store.</p> }
        </section>
        <aside class="bs-v2-info-panel"><p class="bs-v2-info-eyebrow">Before you contact us</p><h2>Start with your order</h2><p>Your account shows the current order, payment and fulfillment status. The FAQ covers common catalog and account questions.</p><div class="bs-v2-info-actions"><a href="@StorefrontRoutes.SignIn" class="bs-v2-button bs-v2-button-primary">Open your account</a><a href="@StorefrontRoutes.Faq" class="bs-v2-button bs-v2-button-secondary">Browse FAQ</a></div></aside>
    </div>
</section>

@code {
    private SeoSettingsDto? _contacts;
    private SeoMetadataDto _metadata = new();
    private StorefrontStructuredDataDocument _structuredData = StorefrontStructuredDataDocument.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _contacts = await SettingsProvider.GetAsync();
        var metadataTask = SeoComposer.ComposeStaticPageAsync(
            "Customer Service",
            StorefrontRoutes.CustomerService,
            "Contact BlazorShop customer service for order assistance, product questions, and storefront support.");
        var structuredDataTask = StructuredDataComposer.ComposeWebPageAsync(
            "Customer Service",
            StorefrontRoutes.CustomerService,
            "Contact BlazorShop customer service for order assistance, product questions, and storefront support.");

        await Task.WhenAll(metadataTask, structuredDataTask);

        _metadata = await metadataTask;
        _structuredData = await structuredDataTask;
    }
}