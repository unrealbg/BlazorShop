{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BankTransfer": {
    "Iban": "",
    "Beneficiary": "",
    "BankName": "",
    "AdditionalInfo": "Include the reference in the transfer reason."
  },
  "Identity": {
    "RequireConfirmedAccount": false,
    "RequireConfirmedEmail": false
  },
  "Runtime": {
    "Security": {
      "RefreshTokenLifetimeDays": 14
    },
    "RateLimiting": {
      "Enabled": false,
      "Auth": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    },
    "Health": {
      "ExposeInProduction": false
    }
  }
}
