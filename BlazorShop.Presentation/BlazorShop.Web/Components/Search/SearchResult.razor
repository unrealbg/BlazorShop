@page "/search-result/{Filter}"

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-6 text-center">
        <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Search Results</h1>
        <p class="mt-1 text-sm text-neutral-600">Browse matching products and keep your filters in the page URL.</p>
    </header>

    <div class="mb-8 rounded-xl border border-neutral-200 bg-white/90 p-4 shadow-sm">
        <div class="grid gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_auto] md:items-end">
            <div>
                <label for="catalog-search" class="mb-1 block text-sm font-semibold text-neutral-800">Search</label>
                <input id="catalog-search"
                       type="search"
                       class="w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 shadow-sm focus:border-neutral-500 focus:outline-none"
                       @bind="_searchInput"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDown" />
            </div>

            <div>
                <label for="catalog-sort" class="mb-1 block text-sm font-semibold text-neutral-800">Sort by</label>
                <select id="catalog-sort"
                        class="w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 shadow-sm focus:border-neutral-500 focus:outline-none"
                        value="@_selectedSort"
                        @onchange="ChangeSort">
                    <option value="NameAscending">Name: A–Z</option>
                    <option value="NameDescending">Name: Z–A</option>
                    <option value="Newest">Newest</option>
                    <option value="Oldest">Oldest</option>
                    <option value="PriceLowToHigh">Price: low to high</option>
                    <option value="PriceHighToLow">Price: high to low</option>
                </select>
            </div>

            <div>
                <label for="catalog-category" class="mb-1 block text-sm font-semibold text-neutral-800">Category</label>
                <select id="catalog-category"
                        class="w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 shadow-sm focus:border-neutral-500 focus:outline-none"
                        value="@(CategoryId?.ToString("D") ?? string.Empty)"
                        @onchange="ChangeCategory">
                    <option value="">All categories</option>
                    @foreach (var category in _categories)
                    {
                        <option value="@category.Id.ToString("D")">@category.Name</option>
                    }
                </select>
            </div>

            <div class="flex gap-2">
                <button type="button"
                        class="inline-flex min-h-11 items-center justify-center rounded-md bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-800"
                        @onclick="ApplySearch">
                    Search
                </button>
                <button type="button"
                        class="inline-flex min-h-11 items-center justify-center rounded-md border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-800 hover:bg-neutral-50"
                        @onclick="ClearFilters">
                    Reset
                </button>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="rounded-md bg-neutral-100 px-6 py-8 text-center text-sm text-neutral-700 shadow-sm" role="status">
            Loading matching products...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="rounded-md bg-red-50 px-6 py-5 text-center text-red-800 shadow" role="alert">
            @_loadError
        </div>
    }
    else if (_searchedProducts.Count > 0)
    {
        <p class="mb-5 text-center text-sm text-neutral-600">
            Found @_searchedProducts.Count item(s) for "@Filter"
        </p>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var product in _searchedProducts)
            {
                <article class="rounded-xl border border-neutral-200 bg-white/80 shadow transition hover:shadow-md">
                    <div class="relative aspect-[4/3] overflow-hidden rounded-t-xl bg-neutral-50">
                        <img src="@product.Image" alt="@product.Name" class="h-full w-full object-cover" loading="lazy" />
                        @if (product.IsNew)
                        {
                            <span class="absolute left-2 top-2 inline-flex items-center rounded-full bg-emerald-600 px-2 py-0.5 text-xs font-semibold text-white shadow">
                                New
                            </span>
                        }
                    </div>

                    <div class="p-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <h2 class="text-base font-semibold text-neutral-900">@product.Name</h2>
                                @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                {
                                    <div class="mt-1 text-xs font-medium uppercase tracking-wide text-neutral-500">@product.CategoryName</div>
                                }
                                <div class="mt-1 text-sm text-neutral-600">Price: <span class="font-semibold text-neutral-900">€ @product.Price</span></div>
                            </div>
                        </div>

                        <div class="mt-4 flex items-center justify-between">
                            <button class="inline-flex items-center gap-2 rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-neutral-800"
                                    @onclick="() => HandleAddToCart(product)">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z" /><path d="M6 6 5 3H3" /></svg>
                                Add To Cart
                            </button>
                            <button class="inline-flex items-center rounded-md px-3 py-1.5 text-sm text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900" @onclick="() => ShowDetailsAsync(product.Id)">See More</button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="rounded-md bg-blue-50 px-6 py-5 text-center text-blue-800 shadow">
            No products found for "@Filter" with the selected filters.
        </div>
        <div class="mt-6 text-center">
            <a href="/" class="inline-flex items-center rounded bg-amber-500 px-4 py-2 font-semibold text-white hover:bg-amber-600">Go Back to Home</a>
        </div>
    }
</section>

<ProductDetails Product="SelectedProduct"
                IsVisible="_showModal"
                OnClose="CloseDetails"
                OnAddToCart="AddItemToCart"
                OnAddToCartVariant="AddVariantToCart" />
