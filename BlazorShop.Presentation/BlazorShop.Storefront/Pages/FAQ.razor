@page "/faq"
@inject IStorefrontSeoComposer SeoComposer
@inject IStorefrontStructuredDataComposer StructuredDataComposer

<SeoHead Metadata="_metadata" StructuredData="_structuredData" />

<section class="bs-v2-info bs-v2-info-faq">
    <header class="bs-v2-info-heading"><p class="bs-v2-info-eyebrow">Support</p><h1>Frequently Asked Questions</h1><p>Quick answers about products, ordering, accounts and the public storefront.</p></header>
    <div class="bs-v2-info-questions">
        @foreach (var faq in _faqs)
        {
            <details class="bs-v2-info-panel"><summary>@faq.Question</summary><p>@faq.Answer</p></details>
        }
    </div>
    <section class="bs-v2-info-panel bs-v2-info-help"><h2>Still need help?</h2><p>Find contact details and account information on our customer service page.</p><a href="@StorefrontRoutes.CustomerService" class="bs-v2-button bs-v2-button-primary">Customer service</a></section>
</section>

@code {
    private SeoMetadataDto _metadata = new();
    private StorefrontStructuredDataDocument _structuredData = StorefrontStructuredDataDocument.Empty;
    private readonly IReadOnlyList<StorefrontFaqStructuredDataItem> _faqs =
    [
        new("Why do products have dedicated pages?", "Published products and categories use dedicated routes so customers and search engines can read the same catalog content."),
        new("What payment methods are available?", "Checkout displays the payment methods currently provided by the store. The application supports Stripe card payments, cash on delivery and bank transfer where enabled."),
        new("How do I check an order?", "Sign in and open Account → Orders to view the order, payment and fulfillment status, plus tracking information when available."),
        new("Do all products appear publicly?", "Only published products with public slugs appear on the public catalog pages."),
    ];

    protected override async Task OnParametersSetAsync()
    {
        var metadataTask = SeoComposer.ComposeStaticPageAsync(
            "Frequently Asked Questions",
            StorefrontRoutes.Faq,
            "Find quick answers about ordering, product availability, storefront pages, and general BlazorShop support.");
        var structuredDataTask = StructuredDataComposer.ComposeFaqPageAsync(
            "Frequently Asked Questions",
            StorefrontRoutes.Faq,
            "Find quick answers about ordering, product availability, storefront pages, and general BlazorShop support.",
            _faqs);

        await Task.WhenAll(metadataTask, structuredDataTask);

        _metadata = await metadataTask;
        _structuredData = await structuredDataTask;
    }
}