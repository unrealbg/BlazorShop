@page "/about-us"
@inject IStorefrontSeoComposer SeoComposer
@inject IStorefrontStructuredDataComposer StructuredDataComposer

<SeoHead Metadata="_metadata" StructuredData="_structuredData" />

<section class="bs-v2-info">
    <header class="bs-v2-info-heading"><p class="bs-v2-info-eyebrow">About BlazorShop</p><h1>A practical .NET commerce starter</h1>
        <p>A layered commerce application with a public storefront and a separate customer and admin workspace.</p></header>
    <div class="bs-v2-info-grid">
        <section class="bs-v2-info-panel"><p class="bs-v2-info-eyebrow">Storefront</p><h2>Discoverable by design</h2><p>Published products and categories have dedicated pages, with real catalog content, metadata and structured data.</p></section>
        <section class="bs-v2-info-panel"><p class="bs-v2-info-eyebrow">Your account</p><h2>Keep your orders together</h2><p>Sign in to view your order history, manage your profile and access account notifications.</p><a href="@StorefrontRoutes.SignIn" class="bs-v2-info-link">Open your account →</a></section>
    </div>
    <section class="bs-v2-info-panel"><p class="bs-v2-info-eyebrow">The application</p><h2>Built around real commerce</h2><p>The storefront and workspace use the same catalog and commerce services. Order, payment and fulfillment statuses remain separate so each stage can be checked in your order history.</p><div class="bs-v2-info-tags"><span>.NET 10</span><span>Blazor</span><span>PostgreSQL</span><span>Stripe</span></div></section>
</section>

@code {
    private SeoMetadataDto _metadata = new();
    private StorefrontStructuredDataDocument _structuredData = StorefrontStructuredDataDocument.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var metadataTask = SeoComposer.ComposeStaticPageAsync(
            "About Us",
            StorefrontRoutes.About,
            "Learn about the BlazorShop storefront, catalog and customer account experience.");
        var structuredDataTask = StructuredDataComposer.ComposeWebPageAsync(
            "About Us",
            StorefrontRoutes.About,
            "Learn about the BlazorShop storefront, catalog and customer account experience.");

        await Task.WhenAll(metadataTask, structuredDataTask);

        _metadata = await metadataTask;
        _structuredData = await structuredDataTask;
    }
}
