@page "/payment-success"
@page "/payment-success/{bt:int?}"
@layout CheckoutLayout

<PageTitle>Order received | BlazorShop</PageTitle>
<HeadContent><meta name="robots" content="noindex,nofollow" /></HeadContent>
<section class="v2-checkout-result v2-checkout-panel">
    <header class="v2-checkout-result-heading">
        <span class="v2-checkout-result-icon" aria-hidden="true">↗</span>
        <div><p class="v2-eyebrow">Checkout result</p><h1>Order received</h1><p class="v2-muted">Check your orders for the current payment and fulfillment status.</p></div>
    </header>
    <div class="v2-checkout-notice" role="status">
        @if (NormalizedPaymentMethod is "card" or "stripe")
        {
            <h2>Card payment: awaiting server confirmation</h2>
            <p>Stripe payment status is confirmed through trusted server notifications. Returning to this page does not confirm payment.</p>
        }
        else if (NormalizedPaymentMethod == "bank" || Bt.GetValueOrDefault() == 1 || BankTransferQuery.GetValueOrDefault() == 1)
        {
            <h2>Bank transfer: payment expected</h2>
            <p>Use the bank transfer instructions provided at checkout. Visiting this page does not confirm receipt of a transfer.</p>
        }
        else if (NormalizedPaymentMethod == "cod")
        {
            <h2>Cash on delivery</h2>
            <p>Payment is collected on delivery. An order confirmation is not a paid status.</p>
        }
        else
        {
            <h2>Check your order status</h2>
            <p>The payment method and current status are available in your orders.</p>
        }
    </div>
    @if (OrderId.HasValue || !string.IsNullOrWhiteSpace(OrderReference))
    {
        <dl class="v2-checkout-bank">
            @if (!string.IsNullOrWhiteSpace(OrderReference))
            {
                <div><dt>Order reference</dt><dd>@OrderReference</dd></div>
            }
            @if (OrderId.HasValue)
            {
                <div><dt>Order ID</dt><dd>@OrderId.Value</dd></div>
            }
        </dl>
    }
    <p class="v2-muted v2-small">Details in this address are navigation references only. The Orders page shows your server-recorded order, payment and fulfillment status.</p>
    <a href="/account/orders" class="bs-button bs-button-primary">View orders</a>
</section>

@code {
    [Parameter]
    public int? Bt { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "bt")]
    public int? BankTransferQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "pm")]
    public string? PaymentMethod { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "order_id")]
    public Guid? OrderId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "reference")]
    public string? OrderReference { get; set; }

    private string? NormalizedPaymentMethod => PaymentMethod?.Trim().ToLowerInvariant();
}
