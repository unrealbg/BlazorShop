@if (Products.Count > 0)
{
    <ul class="bs-v2-product-grid">
        @foreach (var product in Products)
        {
            <li>
                <ProductCard Product="product" />
            </li>
        }
    </ul>
}
else
{
    <div class="bs-v2-empty" role="status">@EmptyMessage</div>
}

@code {
    [Parameter]
    public IReadOnlyList<GetCatalogProduct> Products { get; set; } = Array.Empty<GetCatalogProduct>();

    [Parameter]
    public string EmptyMessage { get; set; } = "No products are available right now.";
}
