@page "/privacy"
@inject IStorefrontSeoComposer SeoComposer
@inject IStorefrontStructuredDataComposer StructuredDataComposer

<SeoHead Metadata="_metadata" StructuredData="_structuredData" />

<article class="bs-v2-info bs-v2-info-legal">
    <header><p class="bs-v2-info-eyebrow">Privacy</p><h1>Privacy Policy</h1><p class="bs-v2-info-notice">This page contains general information. Merchant-specific privacy wording requires approval before production use.</p></header>
    <nav class="bs-v2-info-toc" aria-label="On this page"><a href="#information">Information we collect</a><a href="#use">How we use it</a></nav>
    <div class="bs-v2-info-panel">
        <section id="information"><h2>Information we collect</h2><p>Account details, order information, newsletter subscriptions, and basic storefront usage data may be processed to deliver and improve the service.</p></section>
        <section id="use"><h2>How we use it</h2><p>We use that information to provide catalog pages, process purchases, send operational emails, and improve the customer experience.</p></section>
    </div>
    <a href="@StorefrontRoutes.Terms" class="bs-v2-info-link">Terms &amp; Conditions →</a>
</article>

@code {
    private SeoMetadataDto _metadata = new();
    private StorefrontStructuredDataDocument _structuredData = StorefrontStructuredDataDocument.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var metadataTask = SeoComposer.ComposeStaticPageAsync(
            "Privacy Policy",
            StorefrontRoutes.Privacy,
            "Review how BlazorShop handles customer information, browsing data, and storefront privacy expectations.");
        var structuredDataTask = StructuredDataComposer.ComposeWebPageAsync(
            "Privacy Policy",
            StorefrontRoutes.Privacy,
            "Review how BlazorShop handles customer information, browsing data, and storefront privacy expectations.");

        await Task.WhenAll(metadataTask, structuredDataTask);

        _metadata = await metadataTask;
        _structuredData = await structuredDataTask;
    }
}