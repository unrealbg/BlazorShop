@page "/authentication/register"
@layout AccessLayout

<PageTitle>Create account | BlazorShop</PageTitle>
<div class="v2-registration">
<section class="v2-auth-card" aria-labelledby="register-title">
    <p class="v2-eyebrow">Join BlazorShop</p>
    <h1 id="register-title">Create account</h1>
    <p class="v2-muted">Keep your orders, profile and notifications in one place.</p>
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="v2-notice v2-notice-error" role="alert">@_errorMessage</div>
    }
    <EditForm Model="_user" OnValidSubmit="HandleRegister" class="v2-form" aria-busy="@_isLoading">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />
        <div>
            <FloatingTextInput @bind-Value="_user.FullName" Label="Full Name" autocomplete="name" aria-describedby="register-name-error" />
            <div id="register-name-error"><ValidationMessage For="@(() => _user.FullName)" /></div>
        </div>
        <div>
            <FloatingTextInput @bind-Value="_user.Email" Label="Email Address" Type="email" autocomplete="email" aria-describedby="register-email-error" />
            <div id="register-email-error"><ValidationMessage For="@(() => _user.Email)" /></div>
        </div>
        <div>
            <FloatingTextInput @bind-Value="_user.Password" Label="Password" Type="password" autocomplete="new-password" aria-describedby="register-password-error" />
            <div id="register-password-error"><ValidationMessage For="@(() => _user.Password)" /></div>
        </div>
        <div>
            <FloatingTextInput @bind-Value="_user.ConfirmPassword" Label="Confirm Password" Type="password" autocomplete="new-password" aria-describedby="register-confirm-error" />
            <div id="register-confirm-error"><ValidationMessage For="@(() => _user.ConfirmPassword)" /></div>
        </div>
        <button type="submit" class="bs-button bs-button-primary v2-full" disabled="@_isLoading">@(_isLoading ? "Creating account..." : "Register")</button>
    </EditForm>
    <p class="v2-auth-footer">Already have an account? <a href="/authentication/login/account">Sign in</a></p>
    <p class="v2-muted v2-small">After registration, check your email to confirm your account.</p>
</section>
<aside class="v2-registration-aside">
    <p class="v2-eyebrow">Account access includes</p>
    <h2>One place for your purchases</h2>
    <div class="v2-notice"><strong>Orders</strong><p class="v2-muted">History, shipment status and confirmed order details.</p></div>
    <div class="v2-notice"><strong>Notifications</strong><p class="v2-muted">Sign-in, payment and order updates.</p></div>
    <div class="v2-notice"><strong>Checkout</strong><p class="v2-muted">Continue your purchase with your account.</p></div>
    <a href="/authentication/login/account" class="bs-button bs-button-secondary v2-full">I already have an account</a>
</aside>
</div>
