@page "/terms"
@inject IStorefrontSeoComposer SeoComposer
@inject IStorefrontStructuredDataComposer StructuredDataComposer

<SeoHead Metadata="_metadata" StructuredData="_structuredData" />

<article class="bs-v2-info bs-v2-info-legal">
    <header><p class="bs-v2-info-eyebrow">Terms</p><h1>Terms &amp; Conditions</h1><p class="bs-v2-info-notice">This page contains general information. Merchant-specific terms require approval before production use.</p></header>
    <nav class="bs-v2-info-toc" aria-label="On this page"><a href="#ordering">Catalog and ordering</a><a href="#accounts">Accounts</a></nav>
    <div class="bs-v2-info-panel">
        <section id="ordering"><h2>Catalog and ordering</h2><p>Prices, availability, and product content may change over time. Final order confirmation depends on the active purchase flow and payment completion.</p></section>
        <section id="accounts"><h2>Accounts</h2><p>Customers are responsible for keeping account information accurate and for protecting their own credentials.</p></section>
    </div>
    <a href="@StorefrontRoutes.Privacy" class="bs-v2-info-link">Privacy Policy →</a>
</article>

@code {
    private SeoMetadataDto _metadata = new();
    private StorefrontStructuredDataDocument _structuredData = StorefrontStructuredDataDocument.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var metadataTask = SeoComposer.ComposeStaticPageAsync(
            "Terms & Conditions",
            StorefrontRoutes.Terms,
            "Read the current BlazorShop storefront terms, account responsibilities, and purchase conditions.");
        var structuredDataTask = StructuredDataComposer.ComposeWebPageAsync(
            "Terms & Conditions",
            StorefrontRoutes.Terms,
            "Read the current BlazorShop storefront terms, account responsibilities, and purchase conditions.");

        await Task.WhenAll(metadataTask, structuredDataTask);

        _metadata = await metadataTask;
        _structuredData = await structuredDataTask;
    }
}