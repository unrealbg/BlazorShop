<section class="bs-v2-info bs-v2-info-not-found">
    <div class="bs-v2-info-panel">
        <p class="bs-v2-info-code" aria-hidden="true">404</p>
        <p class="bs-v2-info-eyebrow">Not Found</p>
        <h1>@Title</h1>
        <p>@Message</p>
        <a href="@StorefrontRoutes.Home" class="bs-v2-button bs-v2-button-primary">
            Return to Home
        </a>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;
}
