@page "/account/checkout"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@layout CheckoutLayout

<PageTitle>Checkout | BlazorShop</PageTitle>
<HeadContent><meta name="robots" content="noindex,nofollow" /></HeadContent>
<section class="v2-checkout-page">
    <header class="v2-checkout-heading">
        <p class="v2-eyebrow">Checkout</p>
        <h1>Complete your order</h1>
        <p class="v2-muted">Review your items and choose an available payment method.</p>
    </header>
    @if (!string.IsNullOrWhiteSpace(_cartCookieWarning))
    {
        <div role="alert" class="v2-checkout-notice v2-checkout-warning">@_cartCookieWarning</div>
    }
    @if (_isCartLoading)
    {
        <div role="status" class="v2-checkout-panel v2-checkout-state">Loading your cart...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_cartLoadError))
    {
        <div role="alert" class="v2-checkout-panel v2-checkout-state">
            <h2>We couldn't load your cart</h2>
            <p>@_cartLoadError</p>
            <button type="button" class="bs-button bs-button-primary" @onclick="RetryLoadCartAsync">Retry</button>
        </div>
    }
    else if (_cartLines.Any())
    {
        <div class="v2-checkout-grid">
            <section class="v2-checkout-panel" aria-labelledby="cart-heading">
                <h2 id="cart-heading">My Cart</h2>
                @if (_hasTotalOverflow)
                {
                    <div role="alert" class="v2-checkout-notice v2-checkout-warning">Some cart totals cannot be displayed safely. Review quantities before checkout.</div>
                }
                @if (HasUnavailableCartLines)
                {
                    <div role="alert" class="v2-checkout-notice v2-checkout-warning">One or more cart items are no longer available. Remove them before checkout continues.</div>
                }
                <table class="v2-checkout-lines">
                    <caption class="sr-only">Cart items, quantities and prices</caption>
                    <thead><tr><th scope="col">Product</th><th scope="col">Price (€)</th><th scope="col">Quantity</th><th scope="col">Total</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var line in _cartLines)
                        {
                            var quantityId = $"quantity-{line.ProductId}-{line.VariantId}";
                            <tr @key="(line.ProductId, line.VariantId)">
                                <td data-label="Product">
                                    <div class="v2-checkout-product">
                                        <div class="v2-checkout-thumb"><CheckoutProductImage Source="@line.ImageUrl" Alt="@line.DisplayName" /></div>
                                        <div><strong>@line.DisplayName</strong>
                                            @if (!string.IsNullOrWhiteSpace(line.VariantLabel))
                                            {
                                                <p class="v2-muted v2-small">@line.VariantLabel</p>
                                            }
                                            @if (line.IsUnavailable)
                                            {
                                                <p class="v2-checkout-unavailable">Unavailable in catalog</p>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Price">€ @line.UnitPrice.ToString("F2")</td>
                                <td data-label="Quantity">
                                    <label class="sr-only" for="@quantityId">Quantity for @line.DisplayName @line.VariantLabel</label>
                                    <input id="@quantityId" type="number" value="@line.Quantity" min="1" disabled="@IsCartLineBusy(line.ProductId, line.VariantId)" @onchange="(e) => HandleInputChange(e, line.ProductId, line.VariantId)" />
                                </td>
                                <td data-label="Total"><strong>@line.LineTotalDisplay</strong></td>
                                <td data-label="Actions"><button type="button" class="v2-checkout-remove" title="Remove" aria-label="Remove @line.DisplayName @line.VariantLabel" @onclick="() => RemoveCartItem(line.ProductId, line.VariantId)" disabled="@IsCartLineBusy(line.ProductId, line.VariantId)">Remove</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
            <aside class="v2-checkout-panel v2-checkout-summary" aria-labelledby="summary-heading">
                <h2 id="summary-heading">Order summary</h2>
                <dl>
                    <div><dt>Subtotal</dt><dd>@CartGrandTotalDisplay</dd></div>
                    <div class="v2-checkout-total"><dt>Total</dt><dd>@CartGrandTotalDisplay</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(_paymentMethodsError))
                {
                    <div role="alert" class="v2-checkout-notice v2-checkout-error">
                        <p>@_paymentMethodsError</p>
                        <button type="button" class="bs-button bs-button-secondary" @onclick="RetryLoadPaymentMethodsAsync">Retry payment methods</button>
                    </div>
                }
                <AuthorizeView>
                    <Authorized>
                        <button type="button" class="bs-button bs-button-primary v2-full" disabled="@(HasUnavailableCartLines || _isSavingCart || _isPaymentMethodsLoading || !string.IsNullOrWhiteSpace(_paymentMethodsError) || _processingMethodId.HasValue)" @onclick="() => _showPaymentDialog = true">@(_isPaymentMethodsLoading ? "Loading payment methods..." : "Checkout")</button>
                    </Authorized>
                    <NotAuthorized>
                        <button type="button" class="bs-button bs-button-primary v2-full" @onclick="() => Checkout()">Checkout</button>
                    </NotAuthorized>
                </AuthorizeView>
                <p class="v2-muted v2-small">Prices and availability are checked again when you submit your order.</p>
            </aside>
        </div>
    }
    else
    {
        <div class="v2-checkout-panel v2-checkout-state">
            <h2>My Cart</h2>
            <p>Your cart is empty</p>
            <p class="v2-muted">Add products from the storefront to begin checkout.</p>
        </div>
    }

    <CheckoutDialog @bind-IsVisible="_showPaymentDialog" Busy="@_processingMethodId.HasValue" CloseOnBackdrop="false">
        <Header><h2>Select Payment Method</h2></Header>
        <Body>
            @if (_isPaymentMethodsLoading)
            {
                <p role="status">Loading payment methods...</p>
            }
            else if (!string.IsNullOrWhiteSpace(_paymentMethodsError))
            {
                <div role="alert" class="v2-checkout-notice v2-checkout-error"><p>@_paymentMethodsError</p><button type="button" class="bs-button bs-button-secondary" @onclick="RetryLoadPaymentMethodsAsync">Retry</button></div>
            }
            else if (_paymentMethods.Any())
            {
                <ul class="v2-checkout-methods" aria-label="Available payment methods" aria-busy="@_processingMethodId.HasValue.ToString().ToLowerInvariant()">
                    @foreach (var paymentMethod in _paymentMethods)
                    {
                        <li><strong>@paymentMethod.Name</strong>
                            @if (_processingMethodId == paymentMethod.Id)
                            {
                                <span role="status" class="v2-checkout-processing">Processing...</span>
                            }
                            else
                            {
                                <button type="button" class="bs-button bs-button-primary" aria-label="Select @paymentMethod.Name" @onclick="() => SelectPaymentMethod(paymentMethod)" disabled="@_processingMethodId.HasValue">Select</button>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p role="status">No payment methods are available right now.</p>
            }
        </Body>
        <Footer><button type="button" class="bs-button bs-button-secondary" @onclick="Cancel" disabled="@_processingMethodId.HasValue">Cancel</button></Footer>
    </CheckoutDialog>
    <CheckoutDialog @bind-IsVisible="_showBtDialog" CloseOnBackdrop="false">
        <Header><h2>Bank Transfer Instructions</h2></Header>
        <Body>
            <p class="v2-checkout-notice">Your order is awaiting payment. Use the exact reference when making your transfer.</p>
            <dl class="v2-checkout-bank">
                <div><dt>Bank</dt><dd>@_btInfo.BankName</dd></div>
                <div><dt>Beneficiary</dt><dd>@_btInfo.Beneficiary</dd></div>
                <div><dt>IBAN</dt><dd>@_btInfo.Iban</dd></div>
                <div><dt>Amount</dt><dd>@_btInfo.Amount.ToString("F2") @_btInfo.Currency</dd></div>
                <div><dt>Reference</dt><dd>@_btInfo.Reference</dd></div>
                @if (!string.IsNullOrWhiteSpace(_btInfo.AdditionalInfo))
                {
                    <div><dt>Additional information</dt><dd>@_btInfo.AdditionalInfo</dd></div>
                }
            </dl>
        </Body>
        <Footer>
            <button type="button" class="bs-button bs-button-primary" @onclick="ConfirmBankTransfer">Done</button>
            <button type="button" class="bs-button bs-button-secondary" @onclick="() => _showBtDialog = false">Close</button>
        </Footer>
    </CheckoutDialog>
</section>
