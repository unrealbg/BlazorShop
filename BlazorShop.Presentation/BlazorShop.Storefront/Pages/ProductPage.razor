@page "/product/{Slug}"
@using BlazorShop.Application.Diagnostics
@inject StorefrontApiClient ApiClient
@inject IStorefrontSeoComposer SeoComposer
@inject IStorefrontStructuredDataComposer StructuredDataComposer
@inject ILogger<ProductPage> Logger

<SeoHead Metadata="_metadata" StructuredData="_structuredData" />

@if (_isServiceUnavailable)
{
    <ServiceUnavailableState Title="Product temporarily unavailable"
                             Message="The storefront is running, but the catalog API is not reachable right now. Start the API project or AppHost and refresh this page." />
}
else if (_isNotFound)
{
    <NotFoundState Title="Product not found"
                   Message="We couldn't find a published product for this address." />
}
else if (_product is not null)
{
    <div class="bs-v2-detail bs-v2-container">
        <BreadcrumbNav Items="_breadcrumbs" ClassName="bs-v2-route-breadcrumb" />

        <div class="bs-v2-detail-layout">
            <section class="bs-v2-detail-gallery" aria-label="Product image">
                <div class="bs-v2-detail-image">
                    @if (!string.IsNullOrWhiteSpace(_product.Image))
                    {
                        <img src="@_product.Image" alt="@_product.Name" decoding="async" />
                    }
                    else
                    {
                        <span class="bs-v2-image-placeholder" role="img" aria-label="No product image available">No image available</span>
                    }
                </div>
            </section>

            <section class="bs-v2-detail-info" aria-labelledby="product-title">
                @if (!string.IsNullOrWhiteSpace(_product.Category?.Slug))
                {
                    <a href="@StorefrontRoutes.Category(_product.Category.Slug)" class="bs-v2-detail-category">@_product.Category.Name</a>
                }
                else if (!string.IsNullOrWhiteSpace(_product.Category?.Name))
                {
                    <p class="bs-v2-detail-category">@_product.Category.Name</p>
                }

                @if (IsFreshArrival)
                {
                    <span class="bs-v2-detail-new">New arrival</span>
                }

                <h1 id="product-title">@_product.Name</h1>
                <p class="bs-v2-detail-price-label">@PrimaryPriceLabel</p>
                <p class="bs-v2-detail-price">€ @_product.Price</p>
                <p class="bs-v2-detail-variant-summary">@(_product.Variants.Count() == 1 ? "1 option" : VariantSummary)</p>

                @if (!string.IsNullOrWhiteSpace(_product.Description))
                {
                    <p class="bs-v2-detail-description">@_product.Description</p>
                }

                <div id="purchase" class="bs-v2-detail-purchase">
                    <h2>Add to Cart</h2>
                    <p>@PurchaseMessage</p>
                    @if (_product.Variants.Any())
                    {
                        <div class="bs-v2-detail-field">
                            <label for="product-variant-select">Choose a variant</label>
                            <select id="product-variant-select"
                                    data-storefront-variant-select>
                                <option value="">Select a size</option>
                                @foreach (var variant in _product.Variants)
                                {
                                    <option value="@variant.Id"
                                            data-size-value="@variant.SizeValue"
                                            data-unit-price="@VariantPriceValue(variant)">
                                        @VariantOptionLabel(variant)
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <div class="bs-v2-detail-buy-actions">
                        <button type="button"
                                class="bs-v2-button bs-v2-button-primary"
                                data-storefront-add-to-cart
                                data-default-label="Add to Cart"
                                data-success-label="Added"
                                data-product-id="@_product.Id"
                                data-product-name="@_product.Name"
                                data-unit-price="@BaseUnitPriceValue"
                                data-variant-select="@(_product.Variants.Any() ? "#product-variant-select" : null)"
                                data-feedback-target="#product-cart-feedback">
                            Add to Cart
                        </button>
                        <a href="@CartUrl" class="bs-v2-button bs-v2-button-secondary">View Cart</a>
                    </div>
                    <p id="product-cart-feedback" class="bs-v2-detail-feedback" aria-live="polite"></p>
                </div>

                @if (_product.Variants.Any())
                {
                    <section class="bs-v2-detail-variants" aria-labelledby="product-variants-title">
                        <h2 id="product-variants-title">Available Variants</h2>
                        <ul>
                            @foreach (var variant in _product.Variants)
                            {
                                <li>
                                    <strong>@variant.SizeValue</strong>
                                    <span>@ScaleLabel(variant.SizeScale)</span>
                                    <span>€ @(variant.Price ?? _product.Price)</span>
                                </li>
                            }
                        </ul>
                    </section>
                }

                <nav class="bs-v2-detail-links" aria-label="More shopping options">
                    @if (!string.IsNullOrWhiteSpace(_product.Category?.Slug) && !string.IsNullOrWhiteSpace(_product.Category?.Name))
                    {
                        <a href="@StorefrontRoutes.Category(_product.Category.Slug)" class="bs-v2-button bs-v2-button-secondary">Back to @_product.Category.Name</a>
                    }
                    <a href="@StorefrontRoutes.NewReleases" class="bs-v2-button bs-v2-button-secondary">Browse New Releases</a>
                    <a href="@StorefrontRoutes.TodaysDeals" class="bs-v2-button bs-v2-button-secondary">See Today's Deals</a>
                </nav>

                <p class="bs-v2-detail-help">
                    Questions about sizing, delivery, or returns? Visit
                    <a href="@StorefrontRoutes.CustomerService">Customer Service</a> before you place your order.
                </p>
            </section>
        </div>

        <SeoContentSection Title="@ProductSeoContentTitle"
                           Eyebrow="Product Details"
                           Content="@_product.SeoContent"
                           ClassName="bs-v2-route-seo" />

        <section class="bs-v2-related" aria-labelledby="related-products-title">
            <p class="bs-v2-eyebrow">Keep Exploring</p>
            @if (_relatedProducts.Count > 0)
            {
                <h2 id="related-products-title">More from @_product.Category?.Name</h2>
                <ProductGrid Products="_relatedProducts"
                             EmptyMessage="No additional related products are available right now." />
            }
            else
            {
                <h2 id="related-products-title">Keep browsing the public catalog</h2>
                <nav class="bs-v2-detail-links" aria-label="Continue browsing">
                    @if (!string.IsNullOrWhiteSpace(_product.Category?.Slug) && !string.IsNullOrWhiteSpace(_product.Category?.Name))
                    {
                        <a href="@StorefrontRoutes.Category(_product.Category.Slug)" class="bs-v2-button bs-v2-button-secondary">Explore @_product.Category.Name</a>
                    }
                    <a href="@StorefrontRoutes.NewReleases" class="bs-v2-button bs-v2-button-primary">Browse New Releases</a>
                    <a href="@StorefrontRoutes.TodaysDeals" class="bs-v2-button bs-v2-button-secondary">See Today's Deals</a>
                </nav>
            }
        </section>
    </div>
}

@code {
    private SeoMetadataDto _metadata = new();
    private bool _isNotFound;
    private bool _isServiceUnavailable;
    private GetProduct? _product;
    private IReadOnlyList<StorefrontBreadcrumbItem> _breadcrumbs = [];
    private IReadOnlyList<GetCatalogProduct> _relatedProducts = [];
    private StorefrontStructuredDataDocument _structuredData = StorefrontStructuredDataDocument.Empty;

    private bool IsFreshArrival => _product is not null && DateTime.UtcNow.Subtract(_product.CreatedOn).TotalDays <= 7;

    private string PrimaryPriceLabel => _product?.Variants.Any() == true ? "From" : "Price";

    private string VariantSummary => _product?.Variants.Any() == true
        ? string.Concat(_product.Variants.Count(), " options")
        : "Single option";

    private string CartUrl => StorefrontRoutes.Cart;

    private string PurchaseMessage => _product?.Variants.Any() == true
        ? "Choose a size, add it to your cart, and review it in the storefront cart before checkout."
        : "Add this item now and review it in the storefront cart before checkout.";

    private string BaseUnitPriceValue => (_product?.Price ?? 0m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private string ProductSeoContentTitle => _product?.Name is { Length: > 0 } productName
        ? $"More about {productName}"
        : string.Empty;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var routePath = StorefrontRoutes.Product(Slug);
        var productResult = await ApiClient.GetPublishedProductBySlugAsync(Slug);

        if (productResult.IsServiceUnavailable)
        {
            _product = null;
            _isNotFound = false;
            _isServiceUnavailable = true;
            _breadcrumbs = [];
            _relatedProducts = [];
            _structuredData = StorefrontStructuredDataDocument.Empty;
            StorefrontResponseHeaders.ApplyServiceUnavailable(HttpContext);
            SeoRuntimeLogger.PublicProductServiceUnavailable(Logger, routePath, Slug);

            _metadata = await SeoComposer.ComposeServiceUnavailablePageAsync(
                "Product temporarily unavailable",
                routePath,
                "The storefront is running, but the catalog API is not reachable right now.");
            return;
        }

        _product = productResult.Value;

        if (_product is null)
        {
            _isNotFound = true;
            _isServiceUnavailable = false;
            _breadcrumbs = [];
            _relatedProducts = [];
            _structuredData = StorefrontStructuredDataDocument.Empty;
            StorefrontResponseHeaders.ApplyNotFound(HttpContext);
            SeoRuntimeLogger.PublicProductNotFound(Logger, routePath, Slug);

            _metadata = await SeoComposer.ComposeNotFoundPageAsync(
                "Product not found",
                routePath,
                "We couldn't find a published product for this address.");
            return;
        }

        _isNotFound = false;
        _isServiceUnavailable = false;
        SeoRuntimeLogger.PublicProductResolved(Logger, routePath, Slug, _product.Id);
        _breadcrumbs = BuildBreadcrumbs(_product);

        var metadataTask = SeoComposer.ComposeProductPageAsync(_product);
        var structuredDataTask = StructuredDataComposer.ComposeProductPageAsync(_product);
        var relatedProductsTask = GetRelatedProductsAsync(_product);

        await Task.WhenAll(metadataTask, structuredDataTask, relatedProductsTask);

        _metadata = await metadataTask;
        _structuredData = await structuredDataTask;
        _relatedProducts = await relatedProductsTask;
    }

    private static IReadOnlyList<StorefrontBreadcrumbItem> BuildBreadcrumbs(GetProduct product)
    {
        var breadcrumbs = new List<StorefrontBreadcrumbItem>
        {
            new("Home", StorefrontRoutes.Home),
        };

        if (!string.IsNullOrWhiteSpace(product.Category?.Slug) && !string.IsNullOrWhiteSpace(product.Category?.Name))
        {
            breadcrumbs.Add(new StorefrontBreadcrumbItem(product.Category.Name, StorefrontRoutes.Category(product.Category.Slug)));
        }

        breadcrumbs.Add(new StorefrontBreadcrumbItem(product.Name ?? "Product"));

        return breadcrumbs;
    }

    private async Task<IReadOnlyList<GetCatalogProduct>> GetRelatedProductsAsync(GetProduct product)
    {
        if (string.IsNullOrWhiteSpace(product.Category?.Slug))
        {
            return [];
        }

        var categoryPageResult = await ApiClient.GetPublishedCategoryBySlugAsync(product.Category.Slug);
        if (!categoryPageResult.IsSuccess || categoryPageResult.Value is null)
        {
            return [];
        }

        return categoryPageResult.Value.Products
            .Where(relatedProduct => relatedProduct.Id != product.Id)
            .Where(relatedProduct => !string.IsNullOrWhiteSpace(relatedProduct.Slug))
            .Take(3)
            .ToArray();
    }

    private static string ScaleLabel(int scale)
    {
        return scale switch
        {
            1 => "Clothing",
            2 => "Clothing EU",
            10 => "Shoes EU",
            11 => "Shoes US",
            12 => "Shoes UK",
            _ => "Variant",
        };
    }

    private string VariantPriceValue(GetProductVariant variant)
    {
        var price = variant.Price ?? _product?.Price ?? 0m;
        return price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    }

    private string VariantOptionLabel(GetProductVariant variant)
    {
        var price = variant.Price ?? _product?.Price ?? 0m;
        var defaultLabel = variant.IsDefault ? " • Default" : string.Empty;
        return $"{variant.SizeValue} • {ScaleLabel(variant.SizeScale)} • € {price:0.00}{defaultLabel}";
    }
}
